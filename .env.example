# Database
DB_PASSWORD=clawguard_dev_password
DATABASE_URL=postgres://clawguard:clawguard_dev_password@localhost:5432/clawguard

# Authentication
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars

# HuggingFace
HF_TOKEN=your_huggingface_token_here

# Model Service
MODEL_NAME=openai/gpt-oss-safeguard-20b
SAFEGUARD_MODEL_SIZE=20b
# Shared API key for backend→model-service auth (generate with: openssl rand -hex 32)
MODEL_SERVICE_API_KEY=change-me-to-a-secure-random-key

# Redis
REDIS_URL=redis://localhost:6379

# Backend
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
