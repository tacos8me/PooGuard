# Database (generate a strong password: openssl rand -base64 24)
DB_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgres://pooguard:CHANGE_ME_strong_password_here@localhost:5432/pooguard

# Authentication (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand

# HuggingFace (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Model Service
MODEL_NAME=openai/gpt-oss-safeguard-20b
SAFEGUARD_MODEL_SIZE=20b
# Shared API key for backend-to-model-service auth (generate with: openssl rand -hex 32)
MODEL_SERVICE_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Redis
REDIS_URL=redis://localhost:6379

# Backend
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
