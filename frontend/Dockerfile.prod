FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

# Install openssl for certificate generation (optional, for self-signed certs)
RUN apk add --no-cache openssl

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configurations
COPY nginx.ssl.conf /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf.http-fallback

# Create directory for SSL certificates
RUN mkdir -p /etc/nginx/ssl && \
    chown -R nginx:nginx /etc/nginx/ssl

# Create a startup script that can optionally generate self-signed certificates
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Grant nginx user read access to SSL directory
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
