# PooGuard Backend Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# ENVIRONMENT
# =============================================================================
# REQUIRED: Must be set to one of: development, production, test
# In production, all sensitive variables below MUST be explicitly set
NODE_ENV=development

# =============================================================================
# SERVER
# =============================================================================
# Port for the API server (optional, defaults to 3001)
PORT=3001

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
# REQUIRED in production - no fallback value will be used
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://clawguard:your_secure_password@localhost:5432/clawguard

# =============================================================================
# REDIS
# =============================================================================
# Redis connection URL for caching and pub/sub
# REQUIRED in production - no fallback value will be used
# Format: redis://[:password@]host:port[/database]
# For authenticated Redis: redis://:your_password@localhost:6379
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret key for signing tokens
# REQUIRED in production - no fallback value will be used
# MUST be at least 32 characters long
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# URL for the ML model service (optional, defaults to http://localhost:8000)
MODEL_SERVICE_URL=http://localhost:8000
# API key for authenticating to the model service
# Must match MODEL_SERVICE_API_KEY set on the model-service
MODEL_SERVICE_API_KEY=change-me-to-a-secure-random-key

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins for CORS
# REQUIRED in production - no fallback value will be used
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - NEVER commit the .env file to version control
# - Use strong, unique passwords for DATABASE_URL
# - Use authenticated Redis connections in production (REDIS_URL with password)
# - Generate JWT_SECRET using a cryptographically secure method
# - Rotate secrets periodically in production environments
